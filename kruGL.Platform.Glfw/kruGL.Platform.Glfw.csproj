<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\kruGL.Native\kruGL.Native.csproj" />
    <ProjectReference Include="..\kruGL.OpenGL\kruGL.OpenGL.csproj" />
    <ProjectReference Include="..\kruGL.Platform\kruGL.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GLFW-Net" Version="3.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>kruGL.Platform.Glfw</PackageId>
    <Description>GLFW-based platform implementation for kruGL.</Description>
    <PackageOutputPath>../artifacts/packages</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\native\windows\x64\glfw.dll" Pack="true" PackagePath="runtimes/win-x64/native" Condition="Exists('..\native\windows\x64\glfw.dll')" />
  </ItemGroup>

  <Target Name="CopyLocalGlfwNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <GlfwNativeSource>$(MSBuildThisFileDirectory)..\native\windows\x64\glfw.dll</GlfwNativeSource>
      <GlfwNativeTarget>$(OutDir)glfw.dll</GlfwNativeTarget>
    </PropertyGroup>

    <Copy SourceFiles="$(GlfwNativeSource)"
          DestinationFiles="$(GlfwNativeTarget)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(GlfwNativeSource)')" />
  </Target>

</Project>
